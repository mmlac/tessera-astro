  </section>
  <div class="dashboard">
    <div class="w-layout-blockcontainer container w-container">
      <div class="dashboard-content">
        <div class="hero-dashboard-style">
          <Image src={HeroDashboard} loading="lazy" alt="Thee tiled tab" style="max-height: 600px" class="hero-dashboard-image">
        </div>
      </div>
    </div>
    <div class="dashboard-shape"></div>
  </div>
  
  <section class="section-padding our-features">
    <div class="w-layout-blockcontainer container w-container">
      <div class="our-features-wrapper">
        <div class="our-features-title-area">
          <div class="section-subtitle">Our Features</div>
          <div class="section-title-text">
            <h2 class="featured-section-title section-title">Explore Key Features</h2>
            <p class="feature-section-text">See what Tessera has to offer and how it can enhance your Twitch experience.</p>
          </div>
        </div>
        <div class="our-features-content">
          <div data-w-id="d7e86f3c-9924-3b94-2789-83a6a7debf4f" class="featured-collection">
            <div role="list" class="featured-collection-list">
              <div data-w-id="d7e86f3c-9924-3b94-2789-83a6a7debf51" role="listitem" class="featured-collection-item">
                <div class="large-feature-box">
                  <div class="feature-box-left-content">
                    <div class="feature-title-button">
                      <div class="feature-title-excerpt">
                        <h3 class="feature-card-title">Video and Chat Integration</h3>
                        <p class="feature-card-text">Watch streams and have access to powerful chat features, all in one place.</p>
                      </div>
                      <a data-w-id="88412916-ae61-561d-6215-10843dc3d612" href="/features" class="white-button purple-button w-inline-block">
                        <div class="icon-button-text-box">
                          <div class="button-text-front">Learn More</div>
                          <div class="button-text-back">Learn More</div>
                        </div>
                        <div class="button-icon-box">
                          <img src="images/Vector_1.svg" loading="lazy" alt="Button Icon" class="buton-icon-front">
                          <img src="images/Vector_1.svg" loading="lazy" alt="Button Icon" class="buton-icon-back">
                        </div>
                      </a>
                    </div>
                  </div>
                  <div class="features-box-thumbnail"><Image src={FeatureOneThumb} loading="lazy" style="max-height: 300px;" alt="Thumbnail Feature" class="feature-box-thumbnail"></div>
                  <div class="feature-card-shape"></div>
                </div>
                <div style="opacity:1" class="border-background-color"></div>
                <div class="featured-box-shape _02"></div>
              </div>
            </div>
          </div>
         
        </div>
      </div>
    </div>
  </section>
<section class="profit-loss">
    <div class="w-layout-blockcontainer container w-container">
      <div class="profit-loss-content-wrapper">
        <div data-w-id="8eb91d0b-bd77-4eea-eed7-8f623115a4a2" class="profit-card-top">
          <div class="profit-loss-box _01">
            <div class="graph-content-box"><img src="images/Union.png" loading="lazy" sizes="(max-width: 653px) 100vw, 653px" srcset="images/Union-p-500.png 500w, images/Union.png 653w" alt="Shape" class="graph-box-shape">
              <div class="graph-box-content">
                <Image src={FeatureOneThumb} loading="lazy" alt="TODO" style="max-height: 300px"/>
              </div>
            </div>
            <div class="profit-tax-content">
              <div class="profit-content-title-button">
                <h3 class="content-box-title section-title">Advanced Chat Filters</h3>
                <p class="profit-box-text">Set up complex highlight rules to never miss important messages.</p>
              </div>
              <a data-w-id="88412916-ae61-561d-6215-10843dc3d612" href="/features" class="white-button purple-button w-inline-block">
                <div class="icon-button-text-box">
                  <div class="button-text-front">Learn More</div>
                  <div class="button-text-back">Learn More</div>
                </div>
