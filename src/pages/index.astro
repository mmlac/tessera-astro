---
import BaseLayout from "../layouts/BaseLayout.astro";

import { Image } from "astro:assets";

import HeroDashboard from "../assets/ui/Tessera-three-tiles.png"
import FeatureOneThumb from "../assets/ui/Feature-One-Thumbnail.png"
import FeatureTwoThumb from "../assets/ui/Feature-One-Thumbnail.png"
import VideoThumbnail from "../assets/ui/New-Customer-Dropdown.webp"
