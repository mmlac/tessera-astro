<BaseLayout 
	title="Tessera — Powerful Twitch Desktop App" 
	>
  <main>

    <section data-w-id="a389bcc8-d6c9-f046-7608-0315ae179897" class="hero">
    <div class="w-layout-blockcontainer container hero-container w-container">
      <div class="hero-content-wrapper">
        <div class="hero-content-box">
          <div class="hero-subtitle-title-box">
            <div class="hero-subtitle-box">
              <p data-w-id="29acc6fa-3285-2a67-377b-4d73444f998e" style="opacity:0" class="hero-subtitle"><span class="highlight-sub-text">New </span>Waitlist is now open!</p>
            </div>
            <div class="hero-title-text">
              <h1 class="hero-title">Powerful Twitch Expercience On Your Desktop</h1>
              <p data-w-id="e974015c-7e95-363e-291f-1ffc193ee8ff" style="opacity:0" class="hero-text">
                Tessera is a Twitch desktop app that allows you to watch multiple streams & chats in a tileable window with powerful chat filters and moderation tools.
              </p>
            </div>
          </div>
          <div data-w-id="f0c93810-dcce-2697-21a2-7bf5d1bb8d4f" style="opacity:0" class="hero-button-group">
