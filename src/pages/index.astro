          <div class="section-subtitle">Power Features</div>
          <div class="section-title-text">
            <h2 class="featured-section-title section-title _02">Unleash the Power of Tessera</h2>
            <p class="feature-section-text">Everyday Features and Tools for Power Users</p>
          </div>
        </div>
        <div class="power-features-content">
